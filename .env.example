VITE_EMAILJS_SERVICE_ID=service_ifg3hyt
VITE_EMAILJS_TEMPLATE_ID=template_433t53w
VITE_EMAILJS_PUBLIC_KEY=tCGK85U2zX8KDjUov

# AI Billing & Usage Monitoring
# Shared secret the Python billing backend uses to call back into the Node
# monitoring backend's /internal/ai-billing/* routes. Generate a random value
# (e.g. `openssl rand -hex 32`) and set the SAME value for both processes —
# they already share this repo's root .env, so one line here covers both.
AI_BILLING_INTERNAL_SECRET=
# How often (minutes) each connected AI provider key is polled for new usage/cost data.
AI_BILLING_POLL_INTERVAL_MINUTES=30
